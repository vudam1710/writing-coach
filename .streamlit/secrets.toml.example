# Copy thành .streamlit/secrets.toml (đã gitignore). Trên Streamlit Cloud: dán TOÀN BỘ vào Advanced settings → Secrets.
# Chạy local không có [access_codes] → chế độ dev (vai trò reviewer, không cần mã). Không có SHEET_ID → không lưu.

ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-sonnet-4-5"      # không bắt buộc

SHEET_ID = "1AbC...xyz"                      # phần giữa /d/ và /edit trong URL Google Sheet

# Mỗi người 1 mã (đừng dùng chung). Dạng ngắn = học sinh; dạng {code, role} để chỉ định vai trò.
[access_codes]
minh_hs = "minh-2841"
co_lan  = { code = "lan-7392", role = "reviewer" }

# Không bắt buộc — mặc định như dưới
[limits]
student_daily = 10
reviewer_daily = 20
global_daily = 50

# Copy TỪNG TRƯỜNG từ file JSON của service account (Google Cloud → IAM → Service Accounts → Keys).
# private_key: giữ nguyên các ký tự \n, đặt trong dấu ngoặc kép.
[gcp_service_account]
type = "service_account"
project_id = "writing-coach-xxxx"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = "writing-coach-app@writing-coach-xxxx.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
